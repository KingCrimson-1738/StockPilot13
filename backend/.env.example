# Copy this file to .env for local development. NEVER commit the real .env.

# Neon / Supabase PostgreSQL connection string (use the "pooled" one on Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# OPTIONAL, only when running migrations on Neon: the DIRECT (non-pooler) connection string.
# Leave it out for local development and on Vercel.
# DIRECT_URL=postgresql://USER:PASSWORD@HOST-WITHOUT-POOLER/DBNAME?sslmode=require

# Long random string, generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

# How long a login token stays valid, in minutes
TOKEN_EXPIRY=60
